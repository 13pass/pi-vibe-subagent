  "description": "Delegate isolated tasks from pi to Mistral Vibe subagents",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "vibe",
    "mistral",
    "subagent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/13pass/pi-vibe-subagent.git"
  },
  "homepage": "https://github.com/13pass/pi-vibe-subagent#readme",
  "bugs": "https://github.com/13pass/pi-vibe-subagent/issues",
  "pi": {
